{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "langchart-editor",
  "version": "0.1.0",
  "identifier": "dev.langchart.editor",
  "build": {
    "beforeDevCommand": "npm run dev --prefix ../editor",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build --prefix ../editor",
    "frontendDist": "../../editor/dist"
  },
  "app": {
    "windows": [
      {
        "title": "langchart editor",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Visual statechart editor for langchart workflows",
    "longDescription": "A standalone desktop editor for creating, editing, and testing langchart agentic statechart workflows.",
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "macOS": {
      "entitlements": null,
      "exceptionDomain": ""
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      }
    }
  }
}
